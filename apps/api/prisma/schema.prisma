// GROUPI — schéma Prisma, domaines Utilisateurs + Pédagogique (+ Référentiels support)
// Source de vérité fonctionnelle : docs/referentiel/ (Ch. 2, 3, 9, 10-14, Annexe P)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — Domaine Utilisateurs
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}

enum TeacherProfileStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

/// Ch.7 §7.3/§7.4 : une situation devient ACTIVE (validée ou automatique), ou reste en
/// attente si elle nécessite une validation admin (RM-SCH-012), ou CLOSED/REJECTED à l'issue.
enum SituationStatus {
  ACTIVE
  PENDING_VALIDATION
  CLOSED
  REJECTED
}

// ---------------------------------------------------------------------------
// Enums — Domaine Référentiels
// ---------------------------------------------------------------------------

enum AcademicYearStatus {
  OPEN
  CLOSED
}

enum SchoolType {
  COLLEGE
  HIGH_SCHOOL
  PRIMARY
  OTHER
}

// ---------------------------------------------------------------------------
// Enums — Domaine Pédagogique
// ---------------------------------------------------------------------------

enum TeachingMode {
  PRESENTIAL
  ONLINE
}

enum GroupStatus {
  DRAFT
  ACTIVE
  FULL
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum AbsenceBillingPolicy {
  ALL_BILLED
  EXCUSED_NOT_BILLED
  NONE_BILLED
}

enum VisibilityWhenFull {
  VISIBLE
  HIDDEN
}

enum SessionStatus {
  PLANNED
  POSTPONED
  CANCELLED
  COMPLETED
  LOCKED
}

enum EnrollmentStatus {
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
  /// Ch.12.11 : demande annulée par le Parent avant toute décision du Professeur (RM-INS-038/040).
  CANCELLED
  /// Ch.12.11 : demande sans décision du Professeur au-delà du délai de 7 jours (RM-INS-026/058).
  EXPIRED
}

/// Ch.12.12 : cycle de vie d'une demande de changement de groupe (variante définitive uniquement,
/// voir le commentaire du modèle `GroupChangeRequest`).
enum GroupChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  /// Annulée par le Parent avant toute décision du Professeur (miroir RM-INS-038/040).
  CANCELLED
}

enum PreEnrollmentStatus {
  PENDING
  PROPOSAL_SENT
  CONFIRMED
  REJECTED
  TRANSFORMED
  EXPIRED
  /// Ch.11.14/PRE-STAT-007 : annulée par le Parent avant toute proposition (RM-PRE-020).
  CANCELLED
  /// Ch.11.14/PRE-STAT-006 : clôturée sans transformation (RM-PRE-028) — hors scope MVP (pas de
  /// job planifié ici), la valeur existe pour compléter fidèlement le cycle de vie du référentiel.
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
  LATE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ---------------------------------------------------------------------------
// Enums — Domaine Communication (Ch. 18-19)
// ---------------------------------------------------------------------------

/// Ch.18.6 : les 3 niveaux de priorité déterminent aussi le canal (§18.9) — voir `Activity`.
enum ActivityPriority {
  INFORMATION
  IMPORTANT
  CRITICAL
}

enum CommentAuthorRole {
  TEACHER
  PARENT
}

// ---------------------------------------------------------------------------
// Enums — Domaine Abonnement (Ch. 21)
// ---------------------------------------------------------------------------

/// Ch.21/Annexe P : statuts opérationnels couverts par ce chantier. `DISABLED`/`ARCHIVED` (Ch.4.8)
/// n'ont aucun déclencheur décrit au Ch.21 et sont volontairement omis (voir progress.md).
enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Enums — Domaine Comptable (Ch. 15)
// ---------------------------------------------------------------------------

/// Ch.15.16 : cycle de vie du compte de suivi comptable.
enum AccountingAccountStatus {
  CREATED
  ACTIVE
  LOCKED
  CLOSED
  ARCHIVED
}

/// Ch.15.16 : cycle de vie d'une écriture. Dans ce chantier, une écriture passe directement en
/// POSTED à sa création (aucun flux de brouillon décrit au Ch.15) ; REVERSED marque une écriture
/// annulée par une écriture inverse (RM-CPT-029) ; LOCKED marque une écriture figée par le
/// verrouillage de son compte/période (RM-CPT-020) — elle reste alors définitivement immuable.
enum AccountingEntryStatus {
  CREATED
  POSTED
  REVERSED
  LOCKED
}

/// RM-CPT-008 : PAYMENT/SESSION/ADJUSTMENT + ADMIN_ADJUSTMENT (15.8, hors RM-CPT-008 mais présent
/// dans le tableau et les évènements EVT-CPT-009/010).
enum AccountingEntryType {
  PAYMENT
  SESSION
  ADJUSTMENT
  ADMIN_ADJUSTMENT
}

/// RM-CPT-030 : le montant est toujours positif, le sens comptable (crédit/débit) est porté par
/// ce champ plutôt que déduit du type — nécessaire car une écriture PAYMENT peut être un débit
/// (écriture inverse annulant un paiement erroné, Ch.15.7/15.10) tout en restant de type PAYMENT
/// (RM-CPT-008 : "le type d'une écriture est immuable").
enum AccountingEntryDirection {
  CREDIT
  DEBIT
}

/// Ch.15.4 : état d'une période comptable (généralement une année académique).
enum AccountingPeriodStatus {
  OPEN
  LOCKED
  ARCHIVED
}

/// Ch.15.8 : motifs listés pour un ADJUSTMENT/ADMIN_ADJUSTMENT.
enum AdjustmentReason {
  DATA_ENTRY_ERROR
  ATTENDANCE_CORRECTION
  EXCEPTIONAL_DISCOUNT
  ADMIN_CORRECTION
}

// ---------------------------------------------------------------------------
// Enums — Domaine Export (Ch. 17)
// ---------------------------------------------------------------------------

/// Ch.17.6/RM-EXP-004 : les 3 formats disponibles. Pas d'entrée dédiée pour la portabilité RGPD
/// (17.4 dernier §) : elle réutilise ces mêmes formats ("structuré et couramment utilisé" n'impose
/// pas un format distinct, CSV/Excel le sont déjà) plutôt que d'ajouter une variante spéciale.
enum ExportFormat {
  PDF
  EXCEL
  CSV
}

/// Ch.17.4/17.11 : type de données exportées — reprend la liste du Professeur/Parent, plus les deux
/// cas particuliers Administrateur (statistiques agrégées) et RGPD (portabilité).
enum ExportType {
  GROUPS
  STUDENTS
  ATTENDANCE
  LATENESS
  PEDAGOGICAL_COMMENTS
  ACCOUNTING_ACCOUNTS
  PAYMENTS
  STATISTICS
  DASHBOARD_INDICATORS
  ADMIN_STATISTICS
  RGPD_PERSONAL_DATA
}

/// Ch.17.10 : cycle de vie modélisé fidèlement (RM-EXP-009 — "asynchrone" au-delà du seuil) même si
/// la génération reste synchrone dans ce chantier (voir le commentaire de `ExportsService.generate`)
/// — ni scheduler ni worker séparé dans ce projet, même principe que le reste (Enrollment/Session/
/// Subscription/AccountingAccount ne s'appuient pas non plus sur un job détaché de la requête).
enum ExportJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

/// Ch.17.4 dernier § : portabilité RGPD, traitée manuellement par un Administrateur.
enum DataPortabilityRequestStatus {
  PENDING
  FULFILLED
}

// ---------------------------------------------------------------------------
// Domaine Utilisateurs (référentiel Ch. 3, Annexe P)
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  status          UserStatus
  roles           Role[]
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  deletedAt       DateTime?  @map("deleted_at")

  /// Verrouillage temporaire après échecs d'authentification (RM-SEC-016/037) — distinct de `status`.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  /// Incrémenté à chaque invalidation globale de session (RM-SEC-017/019/030) pour permettre
  /// la révocation immédiate d'un JWT déjà émis (vérifié dans JwtStrategy à chaque requête).
  tokenVersion        Int       @default(0) @map("token_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacherProfile                   TeacherProfile?
  parentProfile                    ParentProfile?
  administrator                    Administrator?
  administratorsCreated            Administrator[]          @relation("AdministratorCreatedBy")
  enrollmentsDecided               Enrollment[]             @relation("EnrollmentDecidedBy")
  groupChangeRequestsDecided       GroupChangeRequest[]     @relation("GroupChangeDecidedBy")
  attendancesRecorded              Attendance[]             @relation("AttendanceRecordedBy")
  attendanceHistoryEntries         AttendanceHistory[]      @relation("AttendanceHistoryChangedBy")
  sessions                         UserSession[]
  passwordResetTokens              PasswordResetToken[]
  loginHistory                     LoginHistory[]
  auditLogs                        AuditLog[]
  /// Ch.18 : centre d'activités personnel (une ligne par activité reçue, tous rôles confondus).
  activities                       Activity[]
  enrollmentCommentsAuthored       EnrollmentComment[]      @relation("EnrollmentCommentAuthor")
  groupAnnouncementsCreated        GroupAnnouncement[]      @relation("GroupAnnouncementAuthor")
  subscriptionsValidated           Subscription[]           @relation("SubscriptionValidatedBy")
  subscriptionsSuspended           Subscription[]           @relation("SubscriptionSuspendedBy")
  accountingEntriesAuthored        AccountingEntry[]        @relation("AccountingEntryAuthor")
  /// Ch.17 : exports demandés par cet utilisateur (RM-EXP-015 : seul l'auteur peut les télécharger).
  exportJobsRequested              ExportJob[]              @relation("ExportJobRequestedBy")
  /// Ch.17 : exports générés PAR cet utilisateur pour le compte d'un autre (RGPD, Ch.17.4 dernier §).
  exportJobsGenerated              ExportJob[]              @relation("ExportJobGeneratedBy")
  exportAudits                     ExportAudit[]            @relation("ExportAuditUser")
  dataPortabilityRequestsMade      DataPortabilityRequest[] @relation("DataPortabilityRequester")
  dataPortabilityRequestsFulfilled DataPortabilityRequest[] @relation("DataPortabilityFulfilledBy")

  @@map("user")
}

/// Journal d'audit — toutes les opérations importantes de GROUPI (Ch.8.10, Annexe P)
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// L'Admin/SuperAdmin auteur de l'action (pas la cible).
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

/// Session persistée créée à chaque connexion (§9.6, RM-SEC-006/020/025) — porte le refresh token.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@map("user_session")
}

/// Lien de réinitialisation de mot de passe, usage unique (RM-SEC-004/005/015)
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_token")
}

/// Journal des connexions, non modifiable (§9.10, RM-SEC-026/027/028)
model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_history")
}

/// Professeur — hérite de User (RM-ACC-*, Ch. 5)
model TeacherProfile {
  id                String               @id @db.Uuid
  user              User                 @relation(fields: [id], references: [id])
  firstName         String               @map("first_name")
  lastName          String               @map("last_name")
  phone             String
  city              String
  bio               String?
  photo             String?
  experience        String?
  completenessScore Int                  @default(0) @map("completeness_score")
  status            TeacherProfileStatus

  subjects          TeacherSubject[]
  schoolLevels      TeacherSchoolLevel[]
  groups            Group[]
  teachingLocations TeachingLocation[]
  preEnrollments    PreEnrollment[]
  subscriptions     Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teacher_profile")
}

/// Parent — hérite de User (Ch. 6)
model ParentProfile {
  id          String    @id @db.Uuid
  user        User      @relation(fields: [id], references: [id])
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String
  city        String
  validatedAt DateTime? @map("validated_at")

  students               Student[]
  preEnrollments         PreEnrollment[]
  /// Ch.19.4 : première lecture de chaque annonce de groupe (RM-COM-011).
  groupAnnouncementReads GroupAnnouncementRead[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("parent_profile")
}

/// Administrateur — hérite de User, délégation du Super Administrateur (Ch. 3.4-3.5)
/// Pas de table SuperAdmin séparée : représenté par Role.SUPER_ADMIN dans User.roles.
model Administrator {
  id          String    @id @db.Uuid
  user        User      @relation(fields: [id], references: [id])
  permissions String[]
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("AdministratorCreatedBy", fields: [createdById], references: [id])
  disabledAt  DateTime? @map("disabled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("administrator")
}

// ---------------------------------------------------------------------------
// Domaine Référentiels (support — requis en FK par Utilisateurs/Pédagogique, Ch. 23)
// ---------------------------------------------------------------------------

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  label     String             @unique
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus

  groups                  Group[]
  preEnrollments          PreEnrollment[]
  studentSchoolSituations StudentSchoolSituation[]
  subscriptions           Subscription[]
  /// Ch.15.4 : créée paresseusement au premier besoin (première activation d'inscription de
  /// l'année), comme le reste des transitions temporelles de ce projet (pas de cron).
  accountingPeriod        AccountingPeriod?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("academic_year")
}

model Subject {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  teacherProfiles TeacherSubject[]
  groups          Group[]
  subjectLevels   SubjectLevel[]
  preEnrollments  PreEnrollment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("subject")
}

model SchoolLevel {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  order    Int
  isActive Boolean @default(true) @map("is_active")

  teacherProfiles         TeacherSchoolLevel[]
  groups                  Group[]
  subjectLevels           SubjectLevel[]
  preEnrollments          PreEnrollment[]
  studentSchoolSituations StudentSchoolSituation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("school_level")
}

/// Combinaisons Matière/Niveau autorisées (référentiel officiel, Ch. 23.8)
model SubjectLevel {
  id            String      @id @default(uuid()) @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  subject       Subject     @relation(fields: [subjectId], references: [id])
  schoolLevelId String      @map("school_level_id") @db.Uuid
  schoolLevel   SchoolLevel @relation(fields: [schoolLevelId], references: [id])
  isAllowed     Boolean     @map("is_allowed")
  isActive      Boolean     @map("is_active")

  @@unique([subjectId, schoolLevelId])
  @@map("subject_level")
}

model City {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  schools School[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("city")
}

model School {
  id                    String     @id @default(uuid()) @db.Uuid
  sourceKey             String?    @unique @map("source_key")
  officialCode          String?    @map("official_code")
  autoCode              String?    @map("auto_code")
  name                  String
  nameAr                String?    @map("name_ar")
  type                  SchoolType
  cityId                String     @map("city_id") @db.Uuid
  city                  City       @relation(fields: [cityId], references: [id])
  address               String?
  regionalDirectorate   String?    @map("regional_directorate")
  regionalDirectorateAr String?    @map("regional_directorate_ar")
  delegation            String?
  delegationAr          String?    @map("delegation_ar")
  regionAr              String?    @map("region_ar")
  cycleAr               String?    @map("cycle_ar")
  latitude              Decimal?   @db.Decimal(9, 6)
  longitude             Decimal?   @db.Decimal(9, 6)
  isActive              Boolean    @default(true) @map("is_active")

  studentSchoolSituations StudentSchoolSituation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("school")
}

/// Table d'association Professeur <-> Matières enseignées (Ch. 5.4)
model TeacherSubject {
  teacherProfileId String         @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  subjectId        String         @map("subject_id") @db.Uuid
  subject          Subject        @relation(fields: [subjectId], references: [id])

  @@id([teacherProfileId, subjectId])
  @@map("teacher_subject")
}

/// Table d'association Professeur <-> Niveaux enseignés (Ch. 5.4)
model TeacherSchoolLevel {
  teacherProfileId String         @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  schoolLevelId    String         @map("school_level_id") @db.Uuid
  schoolLevel      SchoolLevel    @relation(fields: [schoolLevelId], references: [id])

  @@id([teacherProfileId, schoolLevelId])
  @@map("teacher_school_level")
}

// ---------------------------------------------------------------------------
// Domaine Pédagogique (référentiel Ch. 10-14, Annexe P)
// ---------------------------------------------------------------------------

model Student {
  id                       String                  @id @default(uuid()) @db.Uuid
  parentId                 String                  @map("parent_id") @db.Uuid
  parent                   ParentProfile           @relation(fields: [parentId], references: [id])
  firstName                String                  @map("first_name")
  lastName                 String                  @map("last_name")
  dateOfBirth              DateTime?               @map("date_of_birth") @db.Date
  currentSchoolSituationId String?                 @unique @map("current_school_situation_id") @db.Uuid
  currentSchoolSituation   StudentSchoolSituation? @relation("CurrentSituation", fields: [currentSchoolSituationId], references: [id])
  status                   StudentStatus

  schoolSituations StudentSchoolSituation[] @relation("StudentSituations")
  enrollments      Enrollment[]
  preEnrollments   PreEnrollment[]
  attendances      Attendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student")
}

/// Situation scolaire d'un élève pour une année académique donnée (Ch. 7)
model StudentSchoolSituation {
  id              String          @id @default(uuid()) @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  student         Student         @relation("StudentSituations", fields: [studentId], references: [id])
  academicYearId  String          @map("academic_year_id") @db.Uuid
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  schoolLevelId   String          @map("school_level_id") @db.Uuid
  schoolLevel     SchoolLevel     @relation(fields: [schoolLevelId], references: [id])
  schoolId        String          @map("school_id") @db.Uuid
  school          School          @relation(fields: [schoolId], references: [id])
  class           String?
  startDate       DateTime        @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  status          SituationStatus @default(ACTIVE)
  rejectionReason String?         @map("rejection_reason")

  currentForStudent Student? @relation("CurrentSituation")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("student_school_situation")
}

/// Unité pédagogique principale de GROUPI (Ch. 10)
model Group {
  id                         String               @id @default(uuid()) @db.Uuid
  teacherId                  String               @map("teacher_id") @db.Uuid
  teacher                    TeacherProfile       @relation(fields: [teacherId], references: [id])
  subjectId                  String               @map("subject_id") @db.Uuid
  subject                    Subject              @relation(fields: [subjectId], references: [id])
  schoolLevelId              String               @map("school_level_id") @db.Uuid
  schoolLevel                SchoolLevel          @relation(fields: [schoolLevelId], references: [id])
  academicYearId             String               @map("academic_year_id") @db.Uuid
  academicYear               AcademicYear         @relation(fields: [academicYearId], references: [id])
  name                       String
  capacity                   Int
  publicPrice                Decimal              @map("public_price") @db.Decimal(10, 3)
  teachingMode               TeachingMode         @map("teaching_mode")
  absenceBillingPolicy       AbsenceBillingPolicy @map("absence_billing_policy")
  abandonmentThreshold       Int                  @default(3) @map("abandonment_threshold")
  /// RM-CPT-022 : nombre de séances (au tarif appliqué) au-delà duquel un solde débiteur est
  /// considéré "important" (NOT-CPT-003/EVT-CPT-012) — paramétrable à la création du groupe.
  debtAlertThresholdSessions Int                  @default(4) @map("debt_alert_threshold_sessions")
  visibilityWhenFull         VisibilityWhenFull   @map("visibility_when_full")
  startDate                  DateTime             @map("start_date") @db.Date
  endDate                    DateTime?            @map("end_date") @db.Date
  status                     GroupStatus

  schedules                   GroupSchedule[]
  sessions                    Session[]
  enrollments                 Enrollment[]
  /// Ch.11.7/11.8 : préinscriptions auxquelles ce groupe a été proposé.
  proposedToPreEnrollments    PreEnrollment[]
  /// Ch.12.12 : demandes de changement de groupe reçues (ce groupe est la cible B).
  incomingGroupChangeRequests GroupChangeRequest[]
  /// Ch.19.4 : annonces publiées par le Professeur à destination des Parents du groupe.
  announcements               GroupAnnouncement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("group")
}

/// Planning hebdomadaire d'un groupe — créneaux récurrents (Ch. 10.4)
model GroupSchedule {
  id                 String            @id @default(uuid()) @db.Uuid
  groupId            String            @map("group_id") @db.Uuid
  group              Group             @relation(fields: [groupId], references: [id])
  dayOfWeek          DayOfWeek         @map("day_of_week")
  startTime          String            @map("start_time")
  durationMinutes    Int               @map("duration_minutes")
  teachingLocationId String?           @map("teaching_location_id") @db.Uuid
  teachingLocation   TeachingLocation? @relation(fields: [teachingLocationId], references: [id])

  @@map("group_schedule")
}

/// Lieu d'enseignement (terminologie officielle §2.19) — non détaillé dans l'Annexe P,
/// modélisation minimale inférée du Ch. 10 ; à ajuster si le référentiel est complété.
model TeachingLocation {
  id        String         @id @default(uuid()) @db.Uuid
  teacherId String         @map("teacher_id") @db.Uuid
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  label     String
  address   String?
  isActive  Boolean        @default(true) @map("is_active")

  groupSchedules GroupSchedule[]
  sessions       Session[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("teaching_location")
}

/// Séance — occurrence ponctuelle rattachée à un Groupe (Ch. 13)
model Session {
  id                 String            @id @default(uuid()) @db.Uuid
  groupId            String            @map("group_id") @db.Uuid
  group              Group             @relation(fields: [groupId], references: [id])
  date               DateTime          @db.Date
  startTime          String            @map("start_time")
  durationMinutes    Int               @map("duration_minutes")
  teachingMode       TeachingMode      @map("teaching_mode")
  teachingLocationId String?           @map("teaching_location_id") @db.Uuid
  teachingLocation   TeachingLocation? @relation(fields: [teachingLocationId], references: [id])
  status             SessionStatus
  lockedAt           DateTime?         @map("locked_at")

  attendances       Attendance[]
  /// Ch.15.9 : écritures SESSION (facturation) et ADJUSTMENT (correction de présence) référençant cette séance.
  accountingEntries AccountingEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("session")
}

/// Lien administratif, pédagogique et comptable entre un Parent, un Élève et un Groupe (Ch. 12)
model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  student       Student          @relation(fields: [studentId], references: [id])
  groupId       String           @map("group_id") @db.Uuid
  group         Group            @relation(fields: [groupId], references: [id])
  status        EnrollmentStatus
  customPrice   Decimal?         @map("custom_price") @db.Decimal(10, 3)
  paymentMethod String?          @map("payment_method")
  requestedAt   DateTime         @map("requested_at")
  decidedAt     DateTime?        @map("decided_at")
  decidedById   String?          @map("decided_by_id") @db.Uuid
  decidedBy     User?            @relation("EnrollmentDecidedBy", fields: [decidedById], references: [id])

  attendances             Attendance[]
  /// Ch.12.12 : demandes de changement de groupe faites DEPUIS cette inscription (groupe A).
  groupChangeRequestsFrom GroupChangeRequest[] @relation("GroupChangeOriginalEnrollment")
  /// Ch.12.12 : inscription créée dans le groupe B à l'acceptation d'un changement de groupe.
  groupChangeArrival      GroupChangeRequest?  @relation("GroupChangeNewEnrollment")
  /// Ch.19.3 : fil de commentaires privé Professeur/Parent (pas de table "conversation" séparée —
  /// le fil EST l'ensemble ordonné des commentaires de cette inscription).
  comments                EnrollmentComment[]
  /// Ch.15.3/RM-CPT-001/002 : créé automatiquement à l'activation de l'inscription (ACTIVE).
  accountingAccount       AccountingAccount?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("enrollment")
}

/// Ch.12.12 : demande de changement de groupe — variante définitive uniquement dans ce chantier.
/// La variante provisoire (une séance précise couverte ponctuellement par le groupe B, avec
/// présence "Absent excusé" enregistrée côté groupe A) suppose qu'une présence puisse exister
/// sans inscription active dans le groupe où elle est enregistrée ; elle est délibérément hors
/// scope (voir progress.md) plutôt que d'affaiblir `Attendance.enrollmentId` (RM-ATT-022) pour ce
/// seul cas.
///
/// "Le changement de groupe crée systématiquement une nouvelle inscription indépendante" (12.12) :
/// l'acceptation crée une nouvelle `Enrollment` ACTIVE dans le groupe cible (`newEnrollmentId`).
/// L'inscription d'origine n'est archivée qu'à la date effective, appliquée paresseusement à la
/// lecture — même principe que `EnrollmentsService.expireIfDue` / le verrouillage des séances.
model GroupChangeRequest {
  id                   String            @id @default(uuid()) @db.Uuid
  originalEnrollmentId String            @map("original_enrollment_id") @db.Uuid
  originalEnrollment   Enrollment        @relation("GroupChangeOriginalEnrollment", fields: [originalEnrollmentId], references: [id])
  targetGroupId        String            @map("target_group_id") @db.Uuid
  targetGroup          Group             @relation(fields: [targetGroupId], references: [id])
  status               GroupChangeStatus
  requestedAt          DateTime          @map("requested_at")
  decidedAt            DateTime?         @map("decided_at")
  decidedById          String?           @map("decided_by_id") @db.Uuid
  decidedBy            User?             @relation("GroupChangeDecidedBy", fields: [decidedById], references: [id])
  /// Choisie par le Professeur à l'acceptation (RM-INS/12.12 — jamais par le Parent).
  effectiveDate        DateTime?         @map("effective_date") @db.Date
  /// `true` une fois l'inscription d'origine effectivement archivée à la date effective.
  appliedAt            DateTime?         @map("applied_at")
  rejectionReason      String?           @map("rejection_reason")
  newEnrollmentId      String?           @unique @map("new_enrollment_id") @db.Uuid
  newEnrollment        Enrollment?       @relation("GroupChangeNewEnrollment", fields: [newEnrollmentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("group_change_request")
}

/// Manifestation d'intérêt d'un Parent pour une future année académique (Ch. 11)
model PreEnrollment {
  id              String              @id @default(uuid()) @db.Uuid
  parentId        String              @map("parent_id") @db.Uuid
  parent          ParentProfile       @relation(fields: [parentId], references: [id])
  studentId       String              @map("student_id") @db.Uuid
  student         Student             @relation(fields: [studentId], references: [id])
  teacherId       String              @map("teacher_id") @db.Uuid
  teacher         TeacherProfile      @relation(fields: [teacherId], references: [id])
  schoolLevelId   String              @map("school_level_id") @db.Uuid
  schoolLevel     SchoolLevel         @relation(fields: [schoolLevelId], references: [id])
  subjectId       String?             @map("subject_id") @db.Uuid
  subject         Subject?            @relation(fields: [subjectId], references: [id])
  academicYearId  String              @map("academic_year_id") @db.Uuid
  academicYear    AcademicYear        @relation(fields: [academicYearId], references: [id])
  status          PreEnrollmentStatus
  expiresAt       DateTime?           @map("expires_at")
  /// Ch.11.7/11.8 : groupe auquel une proposition a été envoyée (RM-PRE-021/022) — permet de
  /// revérifier la capacité de CE groupe précis au moment de la confirmation par le Parent.
  proposedGroupId String?             @map("proposed_group_id") @db.Uuid
  proposedGroup   Group?              @relation(fields: [proposedGroupId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("pre_enrollment")
}

/// Enregistrement de la participation d'un Élève à une Séance (Ch. 14). Une ligne n'existe que
/// pour un élève ayant déjà reçu un statut (RM-ATT-003) : l'absence de ligne représente
/// ATT-STAT-001/NON_RENSEIGNEE (14.13) sans qu'il soit nécessaire de matérialiser cet état.
/// ATT-STAT-006/VERROUILLEE (14.13) n'est pas non plus une valeur stockée : le verrouillage se
/// déduit de `Session.status`/`lockedAt` (fenêtre alignée sur celle des séances, Ch.14.7), ce qui
/// évite de perdre le statut réel (Présent/Absent excusé/…) au moment du verrouillage.
model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  session      Session          @relation(fields: [sessionId], references: [id])
  studentId    String           @map("student_id") @db.Uuid
  student      Student          @relation(fields: [studentId], references: [id])
  /// RM-ATT-022 : une présence appartient définitivement à une seule inscription.
  enrollmentId String           @map("enrollment_id") @db.Uuid
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  status       AttendanceStatus
  lateDuration Int?             @map("late_duration")
  comment      String?
  recordedAt   DateTime         @map("recorded_at")
  recordedById String           @map("recorded_by_id") @db.Uuid
  recordedBy   User             @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  modifiedAt   DateTime?        @map("modified_at")

  history AttendanceHistory[]

  /// RM-ATT-026 : un élève ne peut posséder qu'une seule présence par séance.
  @@unique([sessionId, studentId])
  @@map("attendance")
}

/// Historique des modifications d'une présence — traçabilité complète (RM-ATT-028, Ch.14.8).
/// Une ligne est créée à chaque saisie initiale et à chaque correction ; jamais modifiée ni
/// supprimée, conformément à RM-ATT-011.
model AttendanceHistory {
  id                   String            @id @default(uuid()) @db.Uuid
  attendanceId         String            @map("attendance_id") @db.Uuid
  attendance           Attendance        @relation(fields: [attendanceId], references: [id])
  previousStatus       AttendanceStatus? @map("previous_status")
  previousLateDuration Int?              @map("previous_late_duration")
  newStatus            AttendanceStatus  @map("new_status")
  newLateDuration      Int?              @map("new_late_duration")
  reason               String?
  /// Ch.14.8 : "Application mobile / Web" — pas d'application mobile dans ce chantier, `WEB` par défaut.
  origin               String            @default("WEB")
  changedById          String            @map("changed_by_id") @db.Uuid
  changedBy            User              @relation("AttendanceHistoryChangedBy", fields: [changedById], references: [id])
  changedAt            DateTime          @default(now()) @map("changed_at")

  @@map("attendance_history")
}

// ---------------------------------------------------------------------------
// Domaine Communication (référentiel Ch. 18-19)
// ---------------------------------------------------------------------------

/// Ch.18 : couvre en un seul modèle les 3 concepts distingués par le référentiel (§18.12) —
/// Activité (la ligne elle-même, immuable, jamais supprimée), Alerte (vue calculée : priority IN
/// (IMPORTANT, CRITICAL) AND readAt IS NULL, jamais stockée séparément) et Notification (la même
/// ligne quand `emailSentAt` est renseigné, RM-NOT-002/004/007-009). Même principe que
/// Session.status/Enrollment.status ailleurs dans ce schéma : ne jamais matérialiser un état
/// entièrement dérivable des autres colonnes.
model Activity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id])
  /// Code métier libre (ex. "SES_EXCEPTIONAL_CREATED"), pas un enum Prisma — miroir de
  /// `AuditLog.action` : évite une migration à chaque nouveau déclencheur NOT-* câblé plus tard.
  type        String
  priority    ActivityPriority
  title       String
  body        String?
  /// Référence polymorphe optionnelle vers l'objet source, miroir `AuditLog.targetType/targetId`
  /// (pas de FK réelle — Enrollment/Session/GroupAnnouncement/EnrollmentComment/...).
  refType     String?          @map("ref_type")
  refId       String?          @map("ref_id") @db.Uuid
  readAt      DateTime?        @map("read_at")
  archivedAt  DateTime?        @map("archived_at")
  /// Renseigné dès que l'e-mail associé a été envoyé avec succès (présence de cette valeur =
  /// "Notification" au sens §18.12, plutôt qu'une simple Activité silencieuse).
  emailSentAt DateTime?        @map("email_sent_at")
  emailError  String?          @map("email_error")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("activity")
}

/// Ch.19.3 : fil de commentaires d'une inscription. Pas de table "conversation" séparée — le fil
/// EST l'ensemble des `EnrollmentComment` d'une même inscription, ordonnés par `createdAt`.
model EnrollmentComment {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @map("enrollment_id") @db.Uuid
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id])
  authorId     String            @map("author_id") @db.Uuid
  author       User              @relation("EnrollmentCommentAuthor", fields: [authorId], references: [id])
  /// Snapshot du rôle au moment de la rédaction (RM-COM-004) — figé même si les rôles du compte
  /// changeaient plus tard, et évite une jointure Teacher/Parent à chaque lecture du fil.
  authorRole   CommentAuthorRole @map("author_role")
  body         String            @db.Text
  editedAt     DateTime?         @map("edited_at")
  /// RM-COM-014 : suppression logique uniquement, jamais physique.
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([enrollmentId, createdAt])
  @@map("enrollment_comment")
}

/// Ch.19.4 : annonce de groupe, Professeur → Parents, unidirectionnelle (RM-COM-009/010).
/// "Statut effectif" (programmée/publiée/expirée) calculé à la lecture, jamais stocké — même
/// principe que `computeLockDeadline`/`isLockable` pour le verrouillage des séances.
model GroupAnnouncement {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id])
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("GroupAnnouncementAuthor", fields: [createdById], references: [id])
  title       String
  body        String    @db.Text
  /// Toujours renseigné : `now()` pour une publication immédiate, date future choisie sinon.
  publishAt   DateTime  @map("publish_at")
  expiresAt   DateTime? @map("expires_at")
  /// RM-COM-014 : suppression logique, historique conservé.
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  reads GroupAnnouncementRead[]

  @@index([groupId, publishAt])
  @@map("group_announcement")
}

/// Première lecture d'une annonce par un Parent (RM-COM-011, "lue par 8 Parents sur 12"). Clé
/// composite = un seul enregistrement par (annonce, parent), jamais mis à jour ensuite.
model GroupAnnouncementRead {
  announcementId String            @map("announcement_id") @db.Uuid
  announcement   GroupAnnouncement @relation(fields: [announcementId], references: [id])
  parentId       String            @map("parent_id") @db.Uuid
  parent         ParentProfile     @relation(fields: [parentId], references: [id])
  readAt         DateTime          @default(now()) @map("read_at")

  @@id([announcementId, parentId])
  @@map("group_announcement_read")
}

// ---------------------------------------------------------------------------
// Domaine Abonnement (Ch. 21 — Gestion des abonnements Professeur)
// ---------------------------------------------------------------------------

/// Catalogue commercial (Ch.4.3/21.3) — Découverte/Intermédiaire/Pro, seedé, jamais créé via l'API.
model SubscriptionPlan {
  id                   String  @id @default(uuid()) @db.Uuid
  code                 String  @unique
  name                 String
  /// Tarif en TND, 0 pour l'offre gratuite.
  price                Int
  /// Nombre max d'inscriptions actives simultanées (RM-SUB-006/007/008) ; `null` = illimité (Pro).
  maxActiveEnrollments Int?    @map("max_active_enrollments")
  /// Ch.21.5 : durée fixe en jours calendaires à partir de l'activation (30 pour Découverte,
  /// exception RM-ABO-001) ; `null` = expire en fin d'année académique comme les autres offres.
  durationDays         Int?    @map("duration_days")
  /// RM-SUB-005/ERR-SUB-004 : offre d'essai utilisable une seule fois par Professeur (Découverte).
  isTrial              Boolean @default(false) @map("is_trial")

  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscription_plan")
}

/// Ch.21 : abonnement d'un Professeur pour une année académique donnée. Statique par construction
/// (un seul par (teacher, académicYear), RM-ABO-005/RM-SUB-023/ERR-ABO-005) — renouveler pour
/// l'année suivante crée toujours une nouvelle ligne (RM-SUB-025), jamais une mise à jour.
model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  teacherId      String             @map("teacher_id") @db.Uuid
  teacher        TeacherProfile     @relation(fields: [teacherId], references: [id])
  planId         String             @map("plan_id") @db.Uuid
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  academicYearId String             @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  status         SubscriptionStatus

  requestedAt DateTime  @map("requested_at")
  /// Date d'activation — immédiate pour l'offre gratuite, à la validation du paiement sinon.
  activatedAt DateTime? @map("activated_at")
  /// Ch.21.5 : calculée à l'activation (jamais recalculée ensuite), fin d'année académique sauf
  /// exception Découverte (`activatedAt` + `durationDays`).
  expiresAt   DateTime? @map("expires_at")

  paidAt        DateTime? @map("paid_at")
  /// V1 : espèces exclusivement (Ch.21.6) — un seul mode possible, pas d'énumération dédiée.
  paymentMethod String?   @map("payment_method")
  validatedById String?   @map("validated_by_id") @db.Uuid
  validatedBy   User?     @relation("SubscriptionValidatedBy", fields: [validatedById], references: [id])

  suspendedAt      DateTime? @map("suspended_at")
  suspendedById    String?   @map("suspended_by_id") @db.Uuid
  suspendedBy      User?     @relation("SubscriptionSuspendedBy", fields: [suspendedById], references: [id])
  suspensionReason String?   @map("suspension_reason")
  reactivatedAt    DateTime? @map("reactivated_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teacherId, academicYearId])
  @@map("subscription")
}

// ---------------------------------------------------------------------------
// Domaine Comptable (Ch. 15 — Le moteur comptable)
// ---------------------------------------------------------------------------
//
// Décisions de modélisation assumées (mêmes principes que le reste du schéma — ne pas
// matérialiser ce qui se déduit, ne pas multiplier les tables pour des variantes d'un même
// concept) :
//  - Pas de table `Payment` séparée : un paiement EST une `AccountingEntry` de type PAYMENT
//    (montant, méthode indicative RM-CPT-023, auteur, date) — la distinction Payment/Écriture du
//    §15.17 n'apporte aucun champ supplémentaire dans ce référentiel, comme `Activity` a déjà
//    absorbé Activité/Alerte/Notification au Ch.18.
//  - Pas de table `AccountingAdjustment` séparée : un ajustement (ADJUSTMENT/ADMIN_ADJUSTMENT)
//    EST une `AccountingEntry` portant un `reason` (`AdjustmentReason`) et une justification.
//  - `AccountingBalance`/`AccountingIndicator` (§15.17) ne sont jamais stockés (RM-CPT-031) : ils
//    sont recalculés à la demande par `AccountingService` à partir des écritures POSTED/LOCKED.

/// Ch.15.4 : période comptable, généralement calquée sur une année académique (1-1). Créée
/// paresseusement (`AccountingService.getOrCreatePeriod`) au premier besoin plutôt qu'au moment de
/// la création de l'année académique, pour ne pas coupler les modules Référentiels/Comptable.
model AccountingPeriod {
  id             String                 @id @default(uuid()) @db.Uuid
  academicYearId String                 @unique @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id])
  openDate       DateTime               @map("open_date") @db.Date
  closeDate      DateTime               @map("close_date") @db.Date
  status         AccountingPeriodStatus @default(OPEN)
  lockedAt       DateTime?              @map("locked_at")

  accounts AccountingAccount[]
  entries  AccountingEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("accounting_period")
}

/// Ch.15.3/15.16 : un compte par inscription (RM-CPT-001/003), jamais par Parent/Élève.
model AccountingAccount {
  id           String                  @id @default(uuid()) @db.Uuid
  enrollmentId String                  @unique @map("enrollment_id") @db.Uuid
  enrollment   Enrollment              @relation(fields: [enrollmentId], references: [id])
  periodId     String                  @map("period_id") @db.Uuid
  period       AccountingPeriod        @relation(fields: [periodId], references: [id])
  status       AccountingAccountStatus @default(CREATED)
  lockedAt     DateTime?               @map("locked_at")
  closedAt     DateTime?               @map("closed_at")
  archivedAt   DateTime?               @map("archived_at")

  entries AccountingEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounting_account")
}

/// Ch.15.6/15.8 : écriture comptable. Immuable une fois POSTED (RM-CPT-005/028) — toute
/// correction crée une ou plusieurs nouvelles écritures (RM-CPT-029), jamais une modification en
/// place. `sessionId` n'est renseigné que pour SESSION (facturation) et les ADJUSTMENT liés à une
/// correction de présence (sert aussi à calculer la fenêtre des 48h, RM-CPT-019, en réutilisant
/// `computeLockDeadline`/`isLockable` de `sessions.service.ts`, comme le fait déjà `AttendanceService`).
model AccountingEntry {
  id              String                   @id @default(uuid()) @db.Uuid
  /// RM-CPT-038 : format ECR-<année>-000001, unique à l'échelle de la plateforme.
  entryNumber     String                   @unique @map("entry_number")
  accountId       String                   @map("account_id") @db.Uuid
  account         AccountingAccount        @relation(fields: [accountId], references: [id])
  periodId        String                   @map("period_id") @db.Uuid
  period          AccountingPeriod         @relation(fields: [periodId], references: [id])
  type            AccountingEntryType
  direction       AccountingEntryDirection
  status          AccountingEntryStatus    @default(POSTED)
  /// RM-CPT-030 : toujours strictement positif — le sens comptable est porté par `direction`.
  amount          Decimal                  @db.Decimal(10, 3)
  effectiveDate   DateTime                 @map("effective_date")
  sessionId       String?                  @map("session_id") @db.Uuid
  session         Session?                 @relation(fields: [sessionId], references: [id])
  reason          AdjustmentReason?
  /// ERR-CPT-010 : justification obligatoire pour tout ADJUSTMENT/ADMIN_ADJUSTMENT.
  reasonNote      String?                  @map("reason_note")
  /// RM-CPT-023 : indicatif uniquement (espèces, chèque, virement...), pour les entrées PAYMENT.
  paymentMethod   String?                  @map("payment_method")
  /// RM-CPT-029 : l'écriture qui annule une écriture précédente (elle, réciproquement, passe à REVERSED).
  reversesEntryId String?                  @unique @map("reverses_entry_id") @db.Uuid
  reversesEntry   AccountingEntry?         @relation("EntryReversal", fields: [reversesEntryId], references: [id])
  reversedBy      AccountingEntry?         @relation("EntryReversal")
  authorId        String                   @map("author_id") @db.Uuid
  author          User                     @relation("AccountingEntryAuthor", fields: [authorId], references: [id])
  lockedAt        DateTime?                @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId, effectiveDate])
  @@index([accountId, sessionId])
  @@map("accounting_entry")
}

/// RM-CPT-038 : compteur atomique par année civile pour la numérotation ECR-<année>-000001.
model AccountingEntrySequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("accounting_entry_sequence")
}

// ---------------------------------------------------------------------------
// Domaine Export (Ch. 17 — Exportation des données)
// ---------------------------------------------------------------------------
//
// Décisions de modélisation assumées :
//  - `ExportJob` stocke les octets générés directement en base (`fileBytes`, type `Bytes`) plutôt
//    que sur un stockage objet (S3...) : ce projet n'a aucune intégration cloud, et le filesystem
//    de CI (GitHub Actions) est éphémère — écrire sur disque rendrait la génération non
//    reproductible en test/CI sans infrastructure supplémentaire. Cohérent avec la posture "V1
//    pragmatique" déjà assumée pour le reste du projet (voir progress.md).
//  - `ExportJob` et `ExportAudit` restent deux objets distincts (RM-EXP-012) : `ExportAudit` ne
//    référence jamais le contenu du fichier, seulement les métadonnées de la demande (comme
//    `AuditLog` pour le reste de la plateforme) — voir le commentaire de chaque modèle.

/// Ch.17.9/17.11 : le fichier généré, photographie des données au moment de la génération
/// (RM-EXP-007). `requestedBy` est le seul autorisé à le télécharger (RM-EXP-015) ; pour un export
/// RGPD généré par un Administrateur au nom d'un autre utilisateur, `requestedBy` reste le titulaire
/// des données concernées (donc le destinataire du téléchargement), `generatedBy` ne sert qu'à la
/// traçabilité de qui a déclenché la génération.
model ExportJob {
  id            String          @id @default(uuid()) @db.Uuid
  requestedById String          @map("requested_by_id") @db.Uuid
  requestedBy   User            @relation("ExportJobRequestedBy", fields: [requestedById], references: [id])
  generatedById String?         @map("generated_by_id") @db.Uuid
  generatedBy   User?           @relation("ExportJobGeneratedBy", fields: [generatedById], references: [id])
  type          ExportType
  format        ExportFormat
  status        ExportJobStatus @default(PENDING)
  /// Critères de sélection utilisés (Ch.17.5) — groupes, période, élève, matière, niveau...
  criteria      Json?
  fileName      String?         @map("file_name")
  fileBytes     Bytes?          @map("file_bytes")
  fileSize      Int?            @map("file_size")
  rowCount      Int?            @map("row_count")
  /// RM-EXP-009/ERR-EXP-005 : volume ayant dépassé le seuil (>10 000 lignes ou >5 Mo) — sert à
  /// l'affichage/aux notifications NOT-EXP-001/002 ; la génération elle-même reste synchrone (voir
  /// le commentaire de section plus haut).
  isAsync       Boolean         @default(false) @map("is_async")
  errorMessage  String?         @map("error_message")
  downloadedAt  DateTime?       @map("downloaded_at")
  readyAt       DateTime?       @map("ready_at")
  /// RM-EXP-008 : `readyAt` + 7 jours — expiration vérifiée paresseusement à la lecture
  /// (`ExportsService.ensureCurrent`), même principe que le reste des transitions temporelles du
  /// projet (pas de cron de nettoyage).
  expiresAt     DateTime?       @map("expires_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  auditEntries           ExportAudit[]
  dataPortabilityRequest DataPortabilityRequest?

  @@index([requestedById, createdAt])
  @@map("export_job")
}

/// Ch.17.8/RM-EXP-006/012 : journal des exports. Objet distinct d'`ExportJob` — ne contient JAMAIS
/// les données exportées elles-mêmes, seulement les métadonnées de la demande. Une ligne est écrite
/// pour CHAQUE demande d'export, y compris les refus (ERR-EXP-001/003/004 : `exportJobId` reste
/// `null` puisqu'aucun fichier n'a alors été produit) — accessible uniquement au Super Admin et aux
/// Admins disposant de la permission `EXP_VIEW_JOURNAL` (PERM-EXP-002).
model ExportAudit {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  user          User         @relation("ExportAuditUser", fields: [userId], references: [id])
  type          ExportType
  format        ExportFormat
  criteria      Json?
  /// SUCCESS | EMPTY | REFUSED_SUBSCRIPTION | REFUSED_FORMAT | REFUSED_UNAUTHORIZED — code métier
  /// libre plutôt qu'un enum Prisma, même principe que `Activity.type`/`AuditLog.action`.
  outcome       String
  refusalReason String?      @map("refusal_reason")
  exportJobId   String?      @map("export_job_id") @db.Uuid
  exportJob     ExportJob?   @relation(fields: [exportJobId], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("export_audit")
}

/// Ch.17.4 dernier § / EVT-EXP-008 : demande de portabilité RGPD, traitée manuellement par un
/// Administrateur. `dueAt` (30 jours) est purement indicatif — aucune conséquence automatique à
/// l'échéance, ce projet n'a pas de scheduler (même limitation que les rappels d'abonnement Ch.21/22).
model DataPortabilityRequest {
  id            String                       @id @default(uuid()) @db.Uuid
  userId        String                       @map("user_id") @db.Uuid
  user          User                         @relation("DataPortabilityRequester", fields: [userId], references: [id])
  status        DataPortabilityRequestStatus @default(PENDING)
  requestedAt   DateTime                     @map("requested_at")
  dueAt         DateTime                     @map("due_at")
  fulfilledAt   DateTime?                    @map("fulfilled_at")
  fulfilledById String?                      @map("fulfilled_by_id") @db.Uuid
  fulfilledBy   User?                        @relation("DataPortabilityFulfilledBy", fields: [fulfilledById], references: [id])
  exportJobId   String?                      @unique @map("export_job_id") @db.Uuid
  exportJob     ExportJob?                   @relation(fields: [exportJobId], references: [id])
  createdAt     DateTime                     @default(now()) @map("created_at")

  @@map("data_portability_request")
}
