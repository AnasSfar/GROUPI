// GROUPI — schéma Prisma, domaines Utilisateurs + Pédagogique (+ Référentiels support)
// Source de vérité fonctionnelle : docs/referentiel/ (Ch. 2, 3, 9, 10-14, Annexe P)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — Domaine Utilisateurs
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}

enum TeacherProfileStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

/// Ch.7 §7.3/§7.4 : une situation devient ACTIVE (validée ou automatique), ou reste en
/// attente si elle nécessite une validation admin (RM-SCH-012), ou CLOSED/REJECTED à l'issue.
enum SituationStatus {
  ACTIVE
  PENDING_VALIDATION
  CLOSED
  REJECTED
}

// ---------------------------------------------------------------------------
// Enums — Domaine Référentiels
// ---------------------------------------------------------------------------

enum AcademicYearStatus {
  OPEN
  CLOSED
}

enum SchoolType {
  COLLEGE
  HIGH_SCHOOL
  PRIMARY
  OTHER
}

// ---------------------------------------------------------------------------
// Enums — Domaine Pédagogique
// ---------------------------------------------------------------------------

enum TeachingMode {
  PRESENTIAL
  ONLINE
}

enum GroupStatus {
  DRAFT
  ACTIVE
  FULL
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum AbsenceBillingPolicy {
  ALL_BILLED
  EXCUSED_NOT_BILLED
  NONE_BILLED
}

enum VisibilityWhenFull {
  VISIBLE
  HIDDEN
}

enum SessionStatus {
  PLANNED
  POSTPONED
  CANCELLED
  COMPLETED
  LOCKED
}

enum EnrollmentStatus {
  PENDING_VALIDATION
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
}

enum PreEnrollmentStatus {
  PENDING
  PROPOSAL_SENT
  CONFIRMED
  REJECTED
  TRANSFORMED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  EXCUSED_ABSENT
  UNEXCUSED_ABSENT
  LATE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ---------------------------------------------------------------------------
// Domaine Utilisateurs (référentiel Ch. 3, Annexe P)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String     @map("password_hash")
  status        UserStatus
  roles         Role[]
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt   DateTime?  @map("last_login_at")
  deletedAt     DateTime?  @map("deleted_at")

  /// Verrouillage temporaire après échecs d'authentification (RM-SEC-016/037) — distinct de `status`.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  /// Incrémenté à chaque invalidation globale de session (RM-SEC-017/019/030) pour permettre
  /// la révocation immédiate d'un JWT déjà émis (vérifié dans JwtStrategy à chaque requête).
  tokenVersion         Int       @default(0) @map("token_version")

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  teacherProfile         TeacherProfile?
  parentProfile          ParentProfile?
  administrator          Administrator?
  administratorsCreated  Administrator[] @relation("AdministratorCreatedBy")
  enrollmentsDecided     Enrollment[]    @relation("EnrollmentDecidedBy")
  sessions               UserSession[]
  passwordResetTokens    PasswordResetToken[]
  loginHistory           LoginHistory[]
  auditLogs              AuditLog[]

  @@map("user")
}

/// Journal d'audit — toutes les opérations importantes de GROUPI (Ch.8.10, Annexe P)
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// L'Admin/SuperAdmin auteur de l'action (pas la cible).
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

/// Session persistée créée à chaque connexion (§9.6, RM-SEC-006/020/025) — porte le refresh token.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@map("user_session")
}

/// Lien de réinitialisation de mot de passe, usage unique (RM-SEC-004/005/015)
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_token")
}

/// Journal des connexions, non modifiable (§9.10, RM-SEC-026/027/028)
model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  success   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_history")
}

/// Professeur — hérite de User (RM-ACC-*, Ch. 5)
model TeacherProfile {
  id                 String                @id @db.Uuid
  user               User                  @relation(fields: [id], references: [id])
  firstName          String                @map("first_name")
  lastName           String                @map("last_name")
  phone              String
  city               String
  bio                String?
  photo              String?
  experience         String?
  completenessScore  Int                   @default(0) @map("completeness_score")
  status             TeacherProfileStatus

  subjects           TeacherSubject[]
  schoolLevels       TeacherSchoolLevel[]
  groups             Group[]
  teachingLocations  TeachingLocation[]
  preEnrollments     PreEnrollment[]

  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@map("teacher_profile")
}

/// Parent — hérite de User (Ch. 6)
model ParentProfile {
  id             String    @id @db.Uuid
  user           User      @relation(fields: [id], references: [id])
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String
  city           String
  validatedAt    DateTime? @map("validated_at")

  students       Student[]
  preEnrollments PreEnrollment[]

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("parent_profile")
}

/// Administrateur — hérite de User, délégation du Super Administrateur (Ch. 3.4-3.5)
/// Pas de table SuperAdmin séparée : représenté par Role.SUPER_ADMIN dans User.roles.
model Administrator {
  id           String    @id @db.Uuid
  user         User      @relation(fields: [id], references: [id])
  permissions  String[]
  createdById  String    @map("created_by_id") @db.Uuid
  createdBy    User      @relation("AdministratorCreatedBy", fields: [createdById], references: [id])
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("administrator")
}

// ---------------------------------------------------------------------------
// Domaine Référentiels (support — requis en FK par Utilisateurs/Pédagogique, Ch. 23)
// ---------------------------------------------------------------------------

model AcademicYear {
  id     String             @id @default(uuid()) @db.Uuid
  label  String             @unique
  startDate DateTime        @map("start_date") @db.Date
  endDate   DateTime        @map("end_date") @db.Date
  status AcademicYearStatus

  groups                  Group[]
  preEnrollments          PreEnrollment[]
  studentSchoolSituations StudentSchoolSituation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("academic_year")
}

model Subject {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  teacherProfiles TeacherSubject[]
  groups          Group[]
  subjectLevels   SubjectLevel[]
  preEnrollments  PreEnrollment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("subject")
}

model SchoolLevel {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  code     String  @unique
  order    Int
  isActive Boolean @default(true) @map("is_active")

  teacherProfiles         TeacherSchoolLevel[]
  groups                  Group[]
  subjectLevels           SubjectLevel[]
  preEnrollments          PreEnrollment[]
  studentSchoolSituations StudentSchoolSituation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("school_level")
}

/// Combinaisons Matière/Niveau autorisées (référentiel officiel, Ch. 23.8)
model SubjectLevel {
  id            String      @id @default(uuid()) @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  subject       Subject     @relation(fields: [subjectId], references: [id])
  schoolLevelId String      @map("school_level_id") @db.Uuid
  schoolLevel   SchoolLevel @relation(fields: [schoolLevelId], references: [id])
  isAllowed     Boolean     @map("is_allowed")
  isActive      Boolean     @map("is_active")

  @@unique([subjectId, schoolLevelId])
  @@map("subject_level")
}

model City {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  schools School[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("city")
}

model School {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  type      SchoolType
  cityId    String     @map("city_id") @db.Uuid
  city      City       @relation(fields: [cityId], references: [id])
  address   String?
  latitude  Decimal?   @db.Decimal(9, 6)
  longitude Decimal?   @db.Decimal(9, 6)
  isActive  Boolean    @default(true) @map("is_active")

  studentSchoolSituations StudentSchoolSituation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("school")
}

/// Table d'association Professeur <-> Matières enseignées (Ch. 5.4)
model TeacherSubject {
  teacherProfileId String         @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  subjectId        String         @map("subject_id") @db.Uuid
  subject          Subject        @relation(fields: [subjectId], references: [id])

  @@id([teacherProfileId, subjectId])
  @@map("teacher_subject")
}

/// Table d'association Professeur <-> Niveaux enseignés (Ch. 5.4)
model TeacherSchoolLevel {
  teacherProfileId String         @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  schoolLevelId    String         @map("school_level_id") @db.Uuid
  schoolLevel      SchoolLevel    @relation(fields: [schoolLevelId], references: [id])

  @@id([teacherProfileId, schoolLevelId])
  @@map("teacher_school_level")
}

// ---------------------------------------------------------------------------
// Domaine Pédagogique (référentiel Ch. 10-14, Annexe P)
// ---------------------------------------------------------------------------

model Student {
  id                       String                  @id @default(uuid()) @db.Uuid
  parentId                 String                  @map("parent_id") @db.Uuid
  parent                   ParentProfile           @relation(fields: [parentId], references: [id])
  firstName                String                  @map("first_name")
  lastName                 String                  @map("last_name")
  dateOfBirth              DateTime?               @map("date_of_birth") @db.Date
  currentSchoolSituationId String?                 @unique @map("current_school_situation_id") @db.Uuid
  currentSchoolSituation   StudentSchoolSituation? @relation("CurrentSituation", fields: [currentSchoolSituationId], references: [id])
  status                   StudentStatus

  schoolSituations StudentSchoolSituation[] @relation("StudentSituations")
  enrollments      Enrollment[]
  preEnrollments   PreEnrollment[]
  attendances      Attendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student")
}

/// Situation scolaire d'un élève pour une année académique donnée (Ch. 7)
model StudentSchoolSituation {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  student        Student      @relation("StudentSituations", fields: [studentId], references: [id])
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolLevelId  String       @map("school_level_id") @db.Uuid
  schoolLevel    SchoolLevel  @relation(fields: [schoolLevelId], references: [id])
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  class          String?
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  status         SituationStatus @default(ACTIVE)
  rejectionReason String?     @map("rejection_reason")

  currentForStudent Student? @relation("CurrentSituation")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("student_school_situation")
}

/// Unité pédagogique principale de GROUPI (Ch. 10)
model Group {
  id                    String                @id @default(uuid()) @db.Uuid
  teacherId             String                @map("teacher_id") @db.Uuid
  teacher               TeacherProfile        @relation(fields: [teacherId], references: [id])
  subjectId             String                @map("subject_id") @db.Uuid
  subject               Subject               @relation(fields: [subjectId], references: [id])
  schoolLevelId         String                @map("school_level_id") @db.Uuid
  schoolLevel           SchoolLevel           @relation(fields: [schoolLevelId], references: [id])
  academicYearId        String                @map("academic_year_id") @db.Uuid
  academicYear          AcademicYear          @relation(fields: [academicYearId], references: [id])
  name                  String
  capacity              Int
  publicPrice           Decimal               @map("public_price") @db.Decimal(10, 3)
  teachingMode          TeachingMode          @map("teaching_mode")
  absenceBillingPolicy  AbsenceBillingPolicy  @map("absence_billing_policy")
  abandonmentThreshold  Int                   @default(3) @map("abandonment_threshold")
  visibilityWhenFull    VisibilityWhenFull    @map("visibility_when_full")
  startDate             DateTime              @map("start_date") @db.Date
  endDate               DateTime?             @map("end_date") @db.Date
  status                GroupStatus

  schedules   GroupSchedule[]
  sessions    Session[]
  enrollments Enrollment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("group")
}

/// Planning hebdomadaire d'un groupe — créneaux récurrents (Ch. 10.4)
model GroupSchedule {
  id                 String            @id @default(uuid()) @db.Uuid
  groupId            String            @map("group_id") @db.Uuid
  group              Group             @relation(fields: [groupId], references: [id])
  dayOfWeek          DayOfWeek         @map("day_of_week")
  startTime          String            @map("start_time")
  durationMinutes    Int               @map("duration_minutes")
  teachingLocationId String?           @map("teaching_location_id") @db.Uuid
  teachingLocation   TeachingLocation? @relation(fields: [teachingLocationId], references: [id])

  @@map("group_schedule")
}

/// Lieu d'enseignement (terminologie officielle §2.19) — non détaillé dans l'Annexe P,
/// modélisation minimale inférée du Ch. 10 ; à ajuster si le référentiel est complété.
model TeachingLocation {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])
  label     String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")

  groupSchedules GroupSchedule[]
  sessions       Session[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("teaching_location")
}

/// Séance — occurrence ponctuelle rattachée à un Groupe (Ch. 13)
model Session {
  id                 String            @id @default(uuid()) @db.Uuid
  groupId            String            @map("group_id") @db.Uuid
  group              Group             @relation(fields: [groupId], references: [id])
  date               DateTime          @db.Date
  startTime          String            @map("start_time")
  durationMinutes    Int               @map("duration_minutes")
  teachingMode       TeachingMode      @map("teaching_mode")
  teachingLocationId String?           @map("teaching_location_id") @db.Uuid
  teachingLocation   TeachingLocation? @relation(fields: [teachingLocationId], references: [id])
  status             SessionStatus
  lockedAt           DateTime?         @map("locked_at")

  attendances Attendance[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("session")
}

/// Lien administratif, pédagogique et comptable entre un Parent, un Élève et un Groupe (Ch. 12)
model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  student       Student          @relation(fields: [studentId], references: [id])
  groupId       String           @map("group_id") @db.Uuid
  group         Group            @relation(fields: [groupId], references: [id])
  status        EnrollmentStatus
  customPrice   Decimal?         @map("custom_price") @db.Decimal(10, 3)
  paymentMethod String?          @map("payment_method")
  requestedAt   DateTime         @map("requested_at")
  decidedAt     DateTime?        @map("decided_at")
  decidedById   String?          @map("decided_by_id") @db.Uuid
  decidedBy     User?            @relation("EnrollmentDecidedBy", fields: [decidedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("enrollment")
}

/// Manifestation d'intérêt d'un Parent pour une future année académique (Ch. 11)
model PreEnrollment {
  id             String              @id @default(uuid()) @db.Uuid
  parentId       String              @map("parent_id") @db.Uuid
  parent         ParentProfile       @relation(fields: [parentId], references: [id])
  studentId      String              @map("student_id") @db.Uuid
  student        Student             @relation(fields: [studentId], references: [id])
  teacherId      String              @map("teacher_id") @db.Uuid
  teacher        TeacherProfile      @relation(fields: [teacherId], references: [id])
  schoolLevelId  String              @map("school_level_id") @db.Uuid
  schoolLevel    SchoolLevel         @relation(fields: [schoolLevelId], references: [id])
  subjectId      String?             @map("subject_id") @db.Uuid
  subject        Subject?            @relation(fields: [subjectId], references: [id])
  academicYearId String              @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id])
  status         PreEnrollmentStatus
  expiresAt      DateTime?           @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("pre_enrollment")
}

/// Enregistrement de la participation d'un Élève à une Séance (Ch. 14)
model Attendance {
  id           String            @id @default(uuid()) @db.Uuid
  sessionId    String            @map("session_id") @db.Uuid
  session      Session           @relation(fields: [sessionId], references: [id])
  studentId    String            @map("student_id") @db.Uuid
  student      Student           @relation(fields: [studentId], references: [id])
  status       AttendanceStatus
  lateDuration Int?              @map("late_duration")
  comment      String?
  recordedAt   DateTime          @map("recorded_at")
  modifiedAt   DateTime?         @map("modified_at")

  @@map("attendance")
}
