DATABASE_URL="postgresql://groupi:groupi@localhost:5432/groupi?schema=public"
# En local, identique à DATABASE_URL (pas de pooler). En prod, ces deux variables sont créées
# automatiquement par l'intégration Vercel/Neon (Storage tab) — ne pas renommer, nécessaire pour
# `prisma migrate deploy` (incompatible avec le pooler PgBouncer en mode transaction).
DATABASE_URL_UNPOOLED="postgresql://groupi:groupi@localhost:5432/groupi?schema=public"

# Vercel uniquement : URL du frontend déployé, pour activer CORS (apps/web et apps/api sont deux
# projets/domaines distincts en prod, contrairement au dev où Vite proxy tout en same-origin).
# CORS_ORIGIN=https://groupi-web.vercel.app

# Vercel uniquement : protège /internal/temporal-jobs/* (voir apps/api/vercel.json "crons").
# Nom de variable imposé — Vercel ajoute automatiquement "Authorization: Bearer <CRON_SECRET>"
# à ses requêtes Cron dès que cette variable existe sur le projet. Sans elle, ces routes
# répondent toujours 401 (voir cron-secret.guard.ts) — jamais de bypass en son absence.
# CRON_SECRET=<valeur aléatoire longue, ex: openssl rand -hex 32>

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
SESSION_INACTIVITY_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

SUPER_ADMIN_EMAIL=admin@groupi.local
SUPER_ADMIN_PASSWORD=admin-local

# Optionnel — sans SMTP_HOST/SMTP_PORT, EmailService journalise seulement (aucun envoi réel).
# Pratique en dev : un compte de test Ethereal (https://ethereal.email) sans credentials réels.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="GROUPI <no-reply@groupi.local>"
