<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links : ouvre directement l'app (sans passer par le navigateur) quand un lien
              d'invitation https://<domaine>/invitation/<token> est tapé (WhatsApp, SMS...).
              android:autoVerify nécessite que <domaine> héberge /.well-known/assetlinks.json avec
              l'empreinte SHA-256 du certificat de signature — voir apps/web/public/.well-known/
              assetlinks.json. Tant que le domaine de production n'est pas figé et que l'app n'est
              pas signée avec un vrai keystore de release, ce filtre est un no-op silencieux : le
              lien continue de s'ouvrir dans le navigateur comme aujourd'hui.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="groupi-web.vercel.app" android:pathPrefix="/invitation" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33) exige cette permission d'exécution pour afficher toute notification —
         @capacitor/push-notifications appelle PushNotifications.requestPermissions() côté JS, qui
         déclenche la boîte de dialogue système correspondant à cette permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
